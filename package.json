{
  "name": "@nino-chavez-labs/blueprint-cli",
  "version": "0.5.0",
  "description": "Blueprint methodology distribution \u2014 canonical docs, reviewer agents, stampers, and the blueprint CLI.",
  "license": "MIT",
  "author": "Nino Chavez",
  "homepage": "https://github.com/nino-chavez/blueprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nino-chavez/blueprint.git"
  },
  "bugs": {
    "url": "https://github.com/nino-chavez/blueprint/issues"
  },
  "keywords": [
    "blueprint",
    "methodology",
    "product-planning",
    "prototyping",
    "agent-assisted",
    "scaffolding"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "bin/",
    "template/",
    "docs/",
    "METHODOLOGY.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "blueprint": "./bin/blueprint.mjs"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node bin/release-if-unpublished.mjs",
    "dev": "npm run dev -w apps/portal",
    "build": "npm run build -w apps/portal",
    "typecheck": "npm run typecheck -w apps/portal"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
