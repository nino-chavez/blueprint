---
import Layout from '@/layouts/Layout.astro';

const REPO = 'the subscriptions initiative's repo (private)/blob/main';

type ReworkCost = 'S' | 'M' | 'L' | 'XL';

interface GapRow {
  n: number;
  dim: string;
  current: string;
  pathA: string;
  pathB: string;
  rework: ReworkCost;
  source?: string;
}

const GAP_ROWS: GapRow[] = [
  { n: 1,  dim: 'Runtime',            current: 'Cloudflare Workers (V8 isolates)', pathA: 'Cloud Run on GCP (Phase 2)', pathB: 'Nomad-scheduled containers in CDE/platform cluster; .container.yml', rework: 'XL', source: 'infrastructure/deployments/containers.md' },
  { n: 2,  dim: 'Language',           current: 'TypeScript (Hono)', pathA: 'TypeScript', pathB: 'Ruby (msms, BigPay) / Scala (api-proxy) / Java — never TS backend', rework: 'XL', source: 'services/merchant-subscription-manager-service.md' },
  { n: 3,  dim: 'Service interface',  current: 'Our REST API (apps/api)', pathA: 'REST + GraphQL', pathB: 'gRPC; protos in bigcommerce/interfaces', rework: 'XL', source: 'technical/standards/interfaces/protobuf-style-guide.md' },
  { n: 4,  dim: 'Public API',         current: 'Our REST is the public surface', pathA: 'Hardened, versioned, OpenAPI', pathB: 'No public API; api-proxy-java composes our gRPC into BC /v3 and GraphQL', rework: 'XL', source: 'services/api-gateway.md' },
  { n: 5,  dim: 'Data store',         current: 'Cloudflare D1 (we own)', pathA: 'Cloud SQL MySQL (we own)', pathB: 'Shared store DB, bounded-context partitioned; never JOIN across contexts', rework: 'L', source: 'technical/standards/bounded-contexts.md' },
  { n: 6,  dim: 'Auth / context',     current: 'OAuth token per merchant install', pathA: 'Same', pathB: 'x-bc-request-context-bin, x-audit-principal-bin, OT-trace via gRPC trailing metadata', rework: 'L', source: 'technical/standards/internal-services/context-propagation.md' },
  { n: 7,  dim: 'Eventing',           current: 'D1 outbox → Worker cron → BC webhooks', pathA: 'Cloud Tasks / Pub-Sub', pathB: 'RabbitMQ Domain Eventing; events in bigcommerce/interfaces', rework: 'L', source: 'technical/standards/domain-eventing.md' },
  { n: 8,  dim: 'Layering',           current: 'App-shaped: routes → handlers → D1', pathA: 'Same', pathB: 'Strict Domain / Application / Infrastructure; immutable cross-layer DTOs', rework: 'M', source: 'technical/standards/layering.md' },
  { n: 9,  dim: 'Bounded context',    current: 'We own our context boundary', pathA: 'Same', pathB: 'Cannot read Orders/Customers/Catalog tables; call their public interfaces', rework: 'M', source: 'technical/standards/bounded-contexts.md' },
  { n: 10, dim: 'Payments / vault',   current: 'Our bc-vault-client wraps BC /v3/payments (ADR-0037)', pathA: 'Same', pathB: 'Direct gRPC into BigPay; no separate vault façade', rework: 'XL', source: 'services/bigpay.md' },
  { n: 11, dim: 'Transactionality',   current: 'Eventual consistency + producer-outbox', pathA: 'Same', pathB: 'Sagas + 2PC; DB transactions within context; events across', rework: 'M', source: 'technical/architecture/transactionality.md' },
  { n: 12, dim: 'Observability',      current: 'Wrangler logs + Analytics Engine', pathA: '+ Sentry, dashboards', pathB: 'Lightstep + logstash app_name + Sentry per-habitat + Prometheus + Grafana', rework: 'L', source: 'services/bigpay.md' },
  { n: 13, dim: 'Deploy',             current: 'wrangler deploy from GHA', pathA: 'GHA → Cloud Run', pathB: 'Launchbay → Nomad → habitats (int/stg/prd); canary + rollback', rework: 'XL', source: 'infrastructure/deployments/strategies.md' },
  { n: 14, dim: 'Secrets',            current: 'Wrangler secrets + Cloudflare KV', pathA: 'GCP Secret Manager', pathB: 'HashiCorp Vault', rework: 'S', source: 'infrastructure/deployments/secrets.md' },
  { n: 15, dim: 'Service mesh',       current: 'n/a (Workers routing)', pathA: 'Cloud Run native', pathB: 'Consul Connect + Envoy sidecars', rework: 'M', source: 'infrastructure/deployments/containers.md' },
  { n: 16, dim: 'Cluster placement',  current: 'n/a', pathA: 'n/a', pathB: 'admin / payments (CDE) / platform — likely payments for PCI scope', rework: 'M', source: 'infrastructure/deployments/containers.md' },
  { n: 17, dim: 'Storefront surface', current: 'Stencil widget + Catalyst SDK + Web Component (ADR-0013)', pathA: 'Same', pathB: 'Native storefront UI in BC storefront-kit / Catalyst directly', rework: 'L' },
  { n: 18, dim: 'Admin surface',      current: 'App Extensions + iframe + our admin app (ADR-0012)', pathA: 'Same', pathB: 'Native control-panel routes in BC App with the platform design system', rework: 'L' },
  { n: 19, dim: 'Merchant audit log', current: 'Our D1 audit_log table', pathA: 'Same', pathB: "BC's merchant-facing audit log surface (BigEng DoD Gate 3)", rework: 'M', source: 'sdlc-frameworks/bigcommerce-bigeng.md (Gate 3)' },
  { n: 20, dim: 'Performance SLO',    current: '≤ 800ms p95 admin; ≤ 1.5s writes', pathA: 'Same', pathB: '< 100ms p95 (BC API DoD); < 200ms TTFB', rework: 'M', source: 'sdlc-frameworks/bigcommerce-bigeng.md (Gate 4)' },
];

const reworkCounts = GAP_ROWS.reduce<Record<ReworkCost, number>>((acc, r) => {
  acc[r.rework] = (acc[r.rework] ?? 0) + 1;
  return acc;
}, { S: 0, M: 0, L: 0, XL: 0 });

const reworkClass: Record<ReworkCost, string> = {
  S:  'border-success/40 bg-success-background/30 text-success-foreground',
  M:  'border-warning/30 bg-warning-background/30 text-warning-foreground',
  L:  'border-warning/50 bg-warning-background/50 text-warning-foreground',
  XL: 'border-error/40 bg-error-background/30 text-error-foreground',
};

type PortTag = 'survives-both' | 'bolt-on-only' | 'first-class-only' | 'requires-rework';

interface PortRow {
  category: 'ADR' | 'Spec' | 'Prototype' | 'Substrate' | 'Tooling';
  id: string;
  topic: string;
  tag: PortTag;
  note?: string;
}

const PORT_ROWS: PortRow[] = [
  // ADRs (curated highlights — full inventory in markdown source)
  { category: 'ADR', id: '0010', topic: 'Webhook / event egress', tag: 'requires-rework', note: 'Path B = RabbitMQ Domain Eventing' },
  { category: 'ADR', id: '0011', topic: 'Charge idempotency + retry semantics', tag: 'survives-both', note: 'Universal behavior' },
  { category: 'ADR', id: '0012', topic: 'Merchant admin stack (Vite + React + the platform design system)', tag: 'requires-rework', note: 'Native admin lives in BC App' },
  { category: 'ADR', id: '0013', topic: 'Storefront-components shape', tag: 'requires-rework', note: 'Native ships in storefront-kit directly' },
  { category: 'ADR', id: '0014', topic: 'Subscriber-surface auth (magic-link + JWT)', tag: 'requires-rework', note: 'Native uses BC session model' },
  { category: 'ADR', id: '0015', topic: 'Observability stack', tag: 'requires-rework', note: 'Path B = Lightstep + Sentry + Prometheus' },
  { category: 'ADR', id: '0016', topic: 'Tax engine — defer to BC', tag: 'survives-both' },
  { category: 'ADR', id: '0023', topic: 'B2B Edition checkout-ownership pattern', tag: 'survives-both', note: 'Architectural pattern, fork-agnostic' },
  { category: 'ADR', id: '0024', topic: 'DeliveryInstance as first-class entity', tag: 'survives-both', note: 'Domain entity' },
  { category: 'ADR', id: '0027', topic: 'Outbox marker + catch-up cron', tag: 'requires-rework', note: 'Eventing mechanism changes' },
  { category: 'ADR', id: '0028', topic: 'Eligibility-engine chokepoint pattern', tag: 'survives-both', note: 'Domain pattern' },
  { category: 'ADR', id: '0029', topic: 'Marketplace-first, native-ready', tag: 'survives-both', note: 'Encodes the fork posture itself' },
  { category: 'ADR', id: '0030', topic: 'BigEng pattern alignment', tag: 'survives-both', note: 'Explicitly bridges to native standards' },
  { category: 'ADR', id: '0037', topic: 'Stored instruments as canonical charge rail', tag: 'requires-rework', note: 'Entire vault façade vestigial in Path B' },
  { category: 'ADR', id: '0038', topic: 'Capture timing', tag: 'survives-both', note: 'BigPay must respect this too' },
  { category: 'ADR', id: '0054', topic: 'Cloud SQL engine', tag: 'bolt-on-only', note: 'Path A Phase 2 specific' },
  { category: 'ADR', id: '0060', topic: 'PCI scope SAQ-A boundary', tag: 'survives-both', note: 'Compliance posture' },
  { category: 'ADR', id: '0061', topic: 'STRIDE payment flow threat model', tag: 'survives-both' },
  { category: 'ADR', id: '0063', topic: 'Email pipeline event pattern', tag: 'requires-rework', note: 'Eventing mechanism changes' },

  // Specs
  { category: 'Spec', id: 'BRD',          topic: 'User stories + AC',                tag: 'survives-both', note: 'Behavioral; what, not how' },
  { category: 'Spec', id: 'PRD',          topic: 'Product surface area',             tag: 'survives-both' },
  { category: 'Spec', id: 'PRD-COMPANION',topic: 'Worked examples',                  tag: 'survives-both' },
  { category: 'Spec', id: 'ARCH',         topic: 'Current architecture document',    tag: 'bolt-on-only', note: 'Documents the bolt-on shape; needs native companion on Path B' },
  { category: 'Spec', id: 'ADMIN-SPEC',   topic: 'Operator surface',                 tag: 'survives-both', note: 'Behavioral; mechanism changes' },
  { category: 'Spec', id: 'PERSONAS',     topic: '5-actor persona model',            tag: 'survives-both', note: 'Identity invariant' },

  // Prototype behaviors
  { category: 'Prototype', id: 'PDP',           topic: 'Subscription PDP widget interactions',   tag: 'survives-both', note: 'Design oracle for native storefront-kit' },
  { category: 'Prototype', id: 'Cart',          topic: 'Cart/checkout subscription affordances', tag: 'survives-both' },
  { category: 'Prototype', id: 'Portal',        topic: 'Account portal flows (manage / pause / skip / cancel)', tag: 'survives-both' },
  { category: 'Prototype', id: 'Admin-UX',      topic: 'Admin dashboard (plans, instances, dunning)', tag: 'survives-both', note: 'Operator UX portable' },
  { category: 'Prototype', id: 'Email',         topic: 'Email previews + templates',             tag: 'survives-both' },
  { category: 'Prototype', id: 'Connect-flow',  topic: 'Connect-your-store flow',                tag: 'bolt-on-only', note: 'Path B has no "connect" step' },
  { category: 'Prototype', id: 'Onboarding',    topic: 'Marketplace install onboarding',         tag: 'bolt-on-only' },

  // Substrate
  { category: 'Substrate', id: 'Hive',         topic: 'Proposal / synthesis / decision workflow',         tag: 'survives-both', note: 'Process is portable' },
  { category: 'Substrate', id: 'hive-meta',    topic: 'hive-meta metadata block',                          tag: 'survives-both' },
  { category: 'Substrate', id: 'ADR-0055',     topic: 'Substrate-derived-from-GH automation',              tag: 'survives-both' },
  { category: 'Substrate', id: 'Methodology',  topic: 'Two-track methodology + 10-gate DoD',               tag: 'survives-both' },

  // Tooling
  { category: 'Tooling', id: 'state-derive',     topic: 'tools/state-derive/',     tag: 'bolt-on-only', note: 'Derives state from our codebase shape' },
  { category: 'Tooling', id: 'hive-board-derive',topic: 'tools/hive-board-derive/',tag: 'survives-both', note: 'Process automation' },
  { category: 'Tooling', id: 'code-review-bot',  topic: 'Code-review bot v1.3',    tag: 'survives-both', note: 'Quality discipline' },
  { category: 'Tooling', id: 'sandbox-CI',       topic: 'Sandbox-scenario CI',     tag: 'survives-both', note: 'Rebinds to native test infra' },
];

const tagClass: Record<PortTag, string> = {
  'survives-both':    'border-success/40 bg-success-background/30 text-success-foreground',
  'bolt-on-only':     'border-warning/30 bg-warning-background/30 text-warning-foreground',
  'first-class-only': 'border-info/30 bg-info-background/30 text-info-foreground',
  'requires-rework':  'border-error/40 bg-error-background/30 text-error-foreground',
};

const tagLabel: Record<PortTag, string> = {
  'survives-both':    '🟢 survives both',
  'bolt-on-only':     '🟡 bolt-on only',
  'first-class-only': '🟣 first-class only',
  'requires-rework':  '🔴 requires rework',
};

const portCounts = PORT_ROWS.reduce<Record<PortTag, number>>((acc, r) => {
  acc[r.tag] = (acc[r.tag] ?? 0) + 1;
  return acc;
}, { 'survives-both': 0, 'bolt-on-only': 0, 'first-class-only': 0, 'requires-rework': 0 });

const portCategories: PortRow['category'][] = ['ADR', 'Spec', 'Prototype', 'Substrate', 'Tooling'];

interface CriterionRow {
  label: string;
  pathA: string;
  pathB: string;
}

const CRITERIA: CriterionRow[] = [
  {
    label: 'Product positioning',
    pathA: 'Durable marketplace offering with rev-share / platform-fee economics',
    pathB: 'BC platform treats subscription billing as native capability, not partner-app concern',
  },
  {
    label: 'Team ownership',
    pathA: 'Continues as current team (you + handoff partners)',
    pathB: 'A Pod (Billing / Payments / new Subscriptions) owns it; staff engineer shepherds gRPC contract',
  },
  {
    label: 'Bounded context boundary',
    pathA: 'We own our context; integrate via public APIs',
    pathB: 'Boundary against Orders / Payments / Customers / BigPay is identifiable and accepted by those domain owners',
  },
  {
    label: 'Release cadence',
    pathA: 'Marketplace-product cadence (we control)',
    pathB: "BC's platform cadence, SLO obligations, on-call rotation",
  },
  {
    label: 'Existing investment',
    pathA: '~95%+ of current code/ADRs/specs continue forward',
    pathB: '~30% directly portable; ~70% serves as executable spec for re-implementation',
  },
  {
    label: 'Native graduation',
    pathA: 'Option, not commitment (ADR-0029)',
    pathB: 'The commitment',
  },
];
---
<Layout
  title="Delivery fork — Strategy"
  description="Bolt-on app vs. first-class platform citizen: gap matrix, portability inventory, decision criteria."
>
  <header class="mb-8 max-w-3xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-wide text-info">
      <a href="/strategy" class="hover:underline">Strategy</a> → Delivery fork
    </p>
    <h1 class="mb-3 font-heading text-4xl font-semibold leading-tight tracking-tight">
      Bolt-on app vs. first-class platform citizen.
    </h1>
    <p class="text-lg leading-relaxed text-contrast-500">
      An open strategic fork: subs-initiative can ship as a BC marketplace app (current shape) or as a native first-class BC service. They are not points on a continuum — they are different runtime substrates with different teams, languages, and operational shapes. This page surfaces the dimension-by-dimension gap, the artifact-level portability inventory, and the decision criteria — so the conversation with stakeholders happens against an honest scope, not abstractions.
    </p>
    <p class="mt-3 font-mono text-[11px] uppercase tracking-wide text-contrast-400">
      Filed 2026-05-22 · Trigger: Slack thread, jordan.sim ↔ nino.chavez · Source authority:
      <a class="text-brand hover:underline" href={`${REPO}/docs/strategy/delivery-fork.md`} target="_blank" rel="noreferrer">docs/strategy/delivery-fork.md ↗</a>
    </p>
  </header>

  {/* ------------------------------------------------------------------- */}
  {/* Section 1: the fork in one paragraph                                  */}
  {/* ------------------------------------------------------------------- */}

  <section class="mb-12 grid gap-4 md:grid-cols-2">
    <div class="rounded-lg border border-warning/30 bg-warning-background/20 p-5">
      <p class="mb-2 font-mono text-[10px] uppercase tracking-wide text-warning-foreground">Path A</p>
      <h2 class="mb-2 font-heading text-xl font-semibold tracking-tight">Marketplace app</h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        BC marketplace app, App Extensions for control panel, own runtime (Cloudflare today / GCP Phase 2 per ADR-0030), consumes BC public APIs, owns its own data store, OAuth client per merchant, own payment-method vault wrapping BC Payments (ADR-0037), shipped/billed/supported as a marketplace product.
      </p>
      <p class="mt-2 font-mono text-[11px] text-contrast-400">~95%+ of current investment on-rails</p>
    </div>
    <div class="rounded-lg border border-info/30 bg-info-background/20 p-5">
      <p class="mb-2 font-mono text-[10px] uppercase tracking-wide text-info">Path B</p>
      <h2 class="mb-2 font-heading text-xl font-semibold tracking-tight">Native first-class</h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        BC domain service owned by a Pod (paralleling Billing Pod's <a class="text-brand hover:underline" href="https://the platform public org/merchant-subscription-manager" target="_blank" rel="noreferrer">msms</a>), Ruby/Scala/Java backend, gRPC interface in <code class="font-mono text-[11px]">bigcommerce/interfaces</code>, Nomad/Launchbay deploy, BigPay direct (not our vault), RabbitMQ Domain Eventing, Lightstep observability, BC's internal request-context propagation.
      </p>
      <p class="mt-2 font-mono text-[11px] text-contrast-400">~30% of current investment directly portable; rest is executable spec</p>
    </div>
  </section>

  {/* ------------------------------------------------------------------- */}
  {/* Section 2: native-shape gap matrix                                    */}
  {/* ------------------------------------------------------------------- */}

  <section class="mb-12">
    <header class="mb-4 flex items-end justify-between">
      <div>
        <h2 class="font-heading text-2xl font-semibold tracking-tight">Native-shape gap matrix</h2>
        <p class="mt-1 text-sm text-contrast-500">
          {GAP_ROWS.length} substantive dimensions where current shape diverges from BigEng standards.
        </p>
      </div>
      <a
        href={`${REPO}/docs/strategy/native-shape-gap.md`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[11px] uppercase tracking-wide text-brand hover:underline"
      >
        full markdown source →
      </a>
    </header>

    <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-4 max-w-3xl">
      <div class={`rounded border px-2 py-1.5 ${reworkClass.S}`}>
        <p class="font-mono text-[10px] uppercase">S — small</p>
        <p class="font-mono text-sm font-semibold">{reworkCounts.S}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${reworkClass.M}`}>
        <p class="font-mono text-[10px] uppercase">M — medium</p>
        <p class="font-mono text-sm font-semibold">{reworkCounts.M}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${reworkClass.L}`}>
        <p class="font-mono text-[10px] uppercase">L — large</p>
        <p class="font-mono text-sm font-semibold">{reworkCounts.L}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${reworkClass.XL}`}>
        <p class="font-mono text-[10px] uppercase">XL — discardable</p>
        <p class="font-mono text-sm font-semibold">{reworkCounts.XL}</p>
      </div>
    </div>

    <div class="overflow-x-auto rounded-lg border border-contrast-200 bg-background">
      <table class="w-full text-sm">
        <thead class="border-b border-contrast-200 bg-contrast-100/40">
          <tr class="text-left font-mono text-[11px] uppercase tracking-wide text-contrast-500">
            <th class="px-3 py-2 w-12">#</th>
            <th class="px-3 py-2">Dimension</th>
            <th class="px-3 py-2">Current</th>
            <th class="px-3 py-2">Path A (marketplace)</th>
            <th class="px-3 py-2">Path B (native)</th>
            <th class="px-3 py-2 w-16">Rework A→B</th>
          </tr>
        </thead>
        <tbody>
          {GAP_ROWS.map((r) => (
            <tr class="border-b border-contrast-100 last:border-b-0 align-top">
              <td class="px-3 py-3 font-mono text-[11px] text-contrast-400">{r.n}</td>
              <td class="px-3 py-3 font-semibold text-foreground">
                {r.dim}
                {r.source && (
                  <p class="mt-1 font-mono text-[10px] font-normal text-contrast-400">
                    <a
                      href={`${REPO}/docs/rag/bc-internal-docs/${r.source}`}
                      target="_blank"
                      rel="noreferrer"
                      class="hover:text-brand hover:underline"
                    >
                      {r.source} ↗
                    </a>
                  </p>
                )}
              </td>
              <td class="px-3 py-3 text-contrast-500">{r.current}</td>
              <td class="px-3 py-3 text-contrast-500">{r.pathA}</td>
              <td class="px-3 py-3 text-contrast-500">{r.pathB}</td>
              <td class="px-3 py-3">
                <span class={`inline-block rounded border px-2 py-0.5 font-mono text-[11px] font-semibold ${reworkClass[r.rework]}`}>
                  {r.rework}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-xs text-contrast-500">
      <strong>Aggregate read:</strong> {reworkCounts.XL} XL, {reworkCounts.L} L, {reworkCounts.M} M, {reworkCounts.S} S across {GAP_ROWS.length} dimensions. Calling Path B "refactoring" understates it — it's a re-implementation with the current codebase serving as executable spec.
    </p>
  </section>

  {/* ------------------------------------------------------------------- */}
  {/* Section 3: portability inventory                                      */}
  {/* ------------------------------------------------------------------- */}

  <section class="mb-12">
    <header class="mb-4 flex items-end justify-between">
      <div>
        <h2 class="font-heading text-2xl font-semibold tracking-tight">Portability inventory</h2>
        <p class="mt-1 text-sm text-contrast-500">
          How each existing artifact travels across the fork. Curated highlights — full inventory (64 ADRs + specs + prototype + substrate + tooling) in the markdown source.
        </p>
      </div>
      <a
        href={`${REPO}/docs/strategy/portability-inventory.md`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[11px] uppercase tracking-wide text-brand hover:underline"
      >
        full markdown source →
      </a>
    </header>

    <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-4 max-w-3xl">
      <div class={`rounded border px-2 py-1.5 ${tagClass['survives-both']}`}>
        <p class="font-mono text-[10px] uppercase">🟢 Survives both</p>
        <p class="font-mono text-sm font-semibold">{portCounts['survives-both']}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${tagClass['bolt-on-only']}`}>
        <p class="font-mono text-[10px] uppercase">🟡 Bolt-on only</p>
        <p class="font-mono text-sm font-semibold">{portCounts['bolt-on-only']}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${tagClass['requires-rework']}`}>
        <p class="font-mono text-[10px] uppercase">🔴 Requires rework</p>
        <p class="font-mono text-sm font-semibold">{portCounts['requires-rework']}</p>
      </div>
      <div class={`rounded border px-2 py-1.5 ${tagClass['first-class-only']}`}>
        <p class="font-mono text-[10px] uppercase">🟣 First-class only</p>
        <p class="font-mono text-sm font-semibold">{portCounts['first-class-only']}</p>
      </div>
    </div>

    {portCategories.map((cat) => {
      const rows = PORT_ROWS.filter((r) => r.category === cat);
      return (
        <details class="mb-3 overflow-hidden rounded-lg border border-contrast-200 bg-background" open>
          <summary class="cursor-pointer border-b border-contrast-100 bg-contrast-100/40 px-4 py-2 font-mono text-[11px] uppercase tracking-wide text-contrast-500">
            {cat} <span class="text-contrast-400">({rows.length})</span>
          </summary>
          <table class="w-full text-sm">
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-contrast-100 last:border-b-0 align-top">
                  <td class="px-3 py-2.5 w-24 font-mono text-[11px] text-contrast-400">{r.id}</td>
                  <td class="px-3 py-2.5 font-semibold text-foreground">{r.topic}</td>
                  <td class="px-3 py-2.5 text-contrast-500">{r.note ?? ''}</td>
                  <td class="px-3 py-2.5 w-44 whitespace-nowrap text-right">
                    <span class={`inline-block rounded border px-2 py-0.5 font-mono text-[11px] font-semibold ${tagClass[r.tag]}`}>
                      {tagLabel[r.tag]}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      );
    })}

    <p class="mt-3 text-xs text-contrast-500">
      <strong>Aggregate read:</strong> ~70% of catalogued artifacts survive both paths (process, behavior, domain rules, methodology). ~20% are bolt-on-only (substrate mechanics, marketplace economics, our API surface). ~10% require implementation rework on Path B (where BC's standards mandate specific mechanisms — eventing, observability, vault, admin/storefront surfaces). The substrate mechanics are the smallest fraction by artifact count but the bulk of the rebuild cost on Path B.
    </p>
  </section>

