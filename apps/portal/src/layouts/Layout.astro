---
import * as Shell from '@blueprint/ui/shell';
import { PortalNav } from '@/components/PortalNav';
// ArchaeologyChat is suppressed by default at the operator-decision layer.
// The substrate is gated in three layers: at stamp time (WORKER_URL blanked),
// at component time (renders a disabled "substrate not configured" button when
// WORKER_URL is empty), and here — even with WORKER_URL configured, the widget
// mounts only when the operator has explicitly flipped ARCHAEOLOGY_READY to true.
// Flip to true ONLY when ALL of the following are met:
//   1. blueprint.yml sets `archaeology.enabled: true`
//   2. `bash tools/archaeology/scaffold.sh` has deployed the project's Worker + ingested sources
//   3. WORKER_URL in src/components/ArchaeologyChat.tsx points at THIS project's substrate
// See docs/patterns/archaeology-substrate-pattern.md for the full setup procedure.
const ARCHAEOLOGY_READY = false;
// Static import — Astro client:* islands MUST be statically imported (a dynamic
// `await import()` here breaks the island bundler at build time). The render
// below is gated on ARCHAEOLOGY_READY, so the disabled island is tree-shaken
// out of the static build when the flag is false (the default).
import { ArchaeologyChat } from '@/components/ArchaeologyChat';
import { portalConfig } from '@/lib/portal-config';
import '@/styles/global.css';

// : the initiative's display name (shown in the <title>
// suffix and footer brand). Stamped at scaffold time.
const PROJECT_NAME = 'Blueprint';
// : one-line tagline shown beside the brand in the footer.
// Leave empty to render the brand alone.
const PROJECT_TAGLINE = 'A methodology + CLI for running product initiatives end-to-end with an AI agent.';

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const fullTitle = title === PROJECT_NAME ? title : `${title} — ${PROJECT_NAME}`;
// Astro.site is set in astro.config.mjs (the Cloudflare Pages production
// origin); unfurl crawlers need absolute URLs, so canonical + og:image
// resolve against it rather than the request path.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogDescription = description ?? PROJECT_TAGLINE;
const ogImage = new URL('/project-logo.png', Astro.site);
// Cloudflare Web Analytics (cookieless RUM). The token is a PUBLIC client-side
// site tag, safe to commit. Empty string = beacon omitted from the build.
// One manual step to activate: CF dashboard → Web Analytics → Add site
// (blueprint.ninochavez.co) → paste the token here. The account-ops API
// token can list but not create RUM sites, so this can't be automated yet.
const CF_BEACON_TOKEN = '';
const config = portalConfig();
const repoUrl = config.repoUrl;
const archaeologySuggestions = config.archaeology.suggestions;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/project-logo.svg" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={PROJECT_NAME} />
    <meta property="og:image" content={ogImage} />
    {/* summary, not summary_large_image: the only share asset is the square
        512x512 project-logo.png — no wide card image exists yet. */}
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
      />
    )}
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Shell.Root>
      <Shell.Header>
        <PortalNav client:load currentPath={currentPath} />
      </Shell.Header>
      <Shell.Main>
        <slot />
      </Shell.Main>
      <Shell.Footer>
        <div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
          <p>
            <span class="font-heading font-semibold text-foreground">{PROJECT_NAME}</span>{PROJECT_TAGLINE && <span> · {PROJECT_TAGLINE}</span>}
          </p>
          {repoUrl && (
            <p class="font-mono text-[12px] uppercase tracking-wide text-contrast-500">
              <a href={repoUrl} target="_blank" rel="noreferrer" class="hover:text-brand">github ↗</a>
              {' · '}
              <a href="https://github.com/nino-chavez/blueprint/releases" target="_blank" rel="noreferrer" class="hover:text-brand">releases ↗</a>
              {' · '}
              {/* The named support channel (OSS table stake): one place to ask. */}
              <a href="https://github.com/nino-chavez/blueprint/issues" target="_blank" rel="noreferrer" class="hover:text-brand">questions &amp; bugs ↗</a>
            </p>
          )}
        </div>
        {/* Reference tier — real destinations, but second-visit depth rather
            than first-visit adoption path (Learn/Try/Demo/Compare/FAQ own the
            top nav for that). Every page on the site renders this footer, so
            these are never more than one click away regardless of entry point
            (IA audit 2026-07-13 — Build/Operate/Roadmap previously had zero
            inbound links from anywhere in the site). */}
        <nav
          aria-label="Reference"
          class="mt-4 flex flex-wrap gap-x-4 gap-y-1 border-t border-contrast-100 pt-4 font-mono text-[11px] uppercase tracking-wide text-contrast-400"
        >
          {/* Labels are reader-job-first (decisions/05): what you come here to
              answer, not the builder's verb for the content pile. */}
          <a href="/discover" class="hover:text-brand">Strategy</a>
          <a href="/build" class="hover:text-brand">For engineers</a>
          <a href="/operate" class="hover:text-brand">Running it</a>
          <a href="/inspect" class="hover:text-brand">Under the hood</a>
          <a href="/roadmap" class="hover:text-brand">Build log</a>
        </nav>
      </Shell.Footer>
    </Shell.Root>
    {ARCHAEOLOGY_READY && <ArchaeologyChat client:idle pageContext={currentPath} suggestions={archaeologySuggestions} />}
  </body>
</html>
