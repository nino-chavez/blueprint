---
import Layout from '@/layouts/Layout.astro';
import { StateMachineView } from '@/components/StateMachineView';
import {
  GREENFIELD_MODEL,
  MIDSTREAM_MODEL,
  BROWNFIELD_MODEL,
  RESEARCH_MODEL,
} from '../../../../template/tools/lib/stage-model.mjs';

// Structure comes straight from the model. The *_MODEL constants are pure data
// (no check functions, no disk access at import), so the chart is DERIVED from
// the machine — it can't drift from stage-model.mjs. We pass only the shape the
// island renders (id/name + gate id/derivable/optional/kind); params dropped.
const models = [GREENFIELD_MODEL, MIDSTREAM_MODEL, BROWNFIELD_MODEL, RESEARCH_MODEL].map((m) => ({
  variant: m.variant,
  stages: m.stages.map((s) => ({
    id: s.id,
    name: s.name,
    gates: s.gates.map((g) => ({ id: g.id, derivable: g.derivable, optional: !!g.optional, kind: g.kind })),
  })),
}));
---
<Layout
  title="The Machine"
  description="Blueprint's pipeline is a state machine: stages, gates, and who decides them — a program (the deterministic core) or a human assertion (the agentic shell). Rendered from the model itself."
>
  <header class="mb-10 max-w-3xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-wide text-brand">the machine</p>
    <h1 class="mb-3 font-heading text-4xl font-semibold leading-tight tracking-tight">
      The pipeline is a state machine.
    </h1>
    <p class="text-lg leading-relaxed text-contrast-500">
      Blueprint's stages aren't prose you hope an agent follows — they're a model a program evaluates.
      Every gate is decided one of two ways: mechanically, from artifacts on disk (the
      <span class="text-brand">deterministic core</span>), or by a human/reviewer assertion for the
      fuzzy edges a disk check can't decide (the <span class="text-warning">agentic shell</span>).
      Move the non-determinism to the edges; keep the determinism at the core.
    </p>
  </header>

  <section aria-label="Stage machine" class="mt-8">
    <StateMachineView models={models} client:load />
  </section>

  <!-- The honest caveat — and the credibility move. A clean left-to-right flow
       would sell a linear pipeline the real fleet disproves. -->
  <section class="mt-12 max-w-3xl rounded-lg border border-contrast-200 bg-contrast-100/30 p-6">
    <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">honest about the line</p>
    <h2 class="mb-3 font-heading text-xl font-semibold tracking-tight text-foreground">
      Real initiatives don't advance in a straight line.
    </h2>
    <p class="mb-3 text-sm leading-relaxed text-contrast-500">
      Drawn as a tidy left-to-right flow, this chart would lie. When we ran the machine against the
      real consumer fleet, initiatives completed stages <b class="font-semibold text-foreground">non-contiguously</b> —
      research done, design-principles skipped, decisions and deploy done. So the tool reports two
      things, not one: a <b class="font-semibold text-foreground">confirmed cursor</b> (how far the
      contiguous spine reaches) and <b class="font-semibold text-foreground">coverage</b> (which
      stages are complete at all, gaps included).
    </p>
    <p class="text-sm leading-relaxed text-contrast-500">
      That calibration also caught the gates themselves: the first run derived a sensible position for
      <b class="font-semibold text-foreground">zero of seven</b> real consumers, because the synthetic
      tests had been circular — shaped to match the gates. The gates are now layout-tolerant, and the
      finding is on the record. Determinism isn't a green test suite; it's the model surviving contact
      with reality.
    </p>
  </section>

  <nav aria-label="Where next" class="mt-12 border-t border-contrast-100 pt-8">
    <p class="mb-4 font-mono text-[12px] uppercase tracking-wide text-brand-strong">where next</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <a href="/demo" class="group block rounded-lg border border-contrast-200 bg-background p-5 transition-colors hover:border-brand/60">
        <h2 class="mb-1 font-heading text-base font-semibold tracking-tight text-foreground group-hover:text-brand">See it run →</h2>
        <p class="text-sm leading-relaxed text-contrast-500">The demo reel — real transcripts and artifacts, no mockups.</p>
      </a>
      <a href="/try" class="group block rounded-lg border border-contrast-200 bg-background p-5 transition-colors hover:border-brand/60">
        <h2 class="mb-1 font-heading text-base font-semibold tracking-tight text-foreground group-hover:text-brand">Run the machine →</h2>
        <p class="text-sm leading-relaxed text-contrast-500"><code class="font-mono text-[13px]">blueprint stage status</code> derives your own position from disk.</p>
      </a>
      <a href="/learn" class="group block rounded-lg border border-contrast-200 bg-background p-5 transition-colors hover:border-brand/60">
        <h2 class="mb-1 font-heading text-base font-semibold tracking-tight text-foreground group-hover:text-brand">Why a model →</h2>
        <p class="text-sm leading-relaxed text-contrast-500">The methodology behind the machine — and why prose control flow rots.</p>
      </a>
    </div>
  </nav>
</Layout>
