---
import Layout from '@/layouts/Layout.astro';

// Bespoke "see it work" page (decisions/02-portal-bespoke-product-site.md).
// The stamped Pattern A surface this replaced iframed THIS SAME SITE back into
// itself and taught blueprint.yml plumbing on a first-touch page — both wrong
// for a product site. The demo reel is the proof surface now; the live
// instance card and /learn carry the onward path.
---
<Layout title="Try" description="See it work — watch the demo, poke the live instance, then run it yourself.">
  <header class="mb-10 max-w-3xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-wide text-success">Try</p>
    <h1 class="mb-3 font-heading text-4xl font-semibold leading-tight tracking-tight">
      See it work.
    </h1>
    <p class="text-lg leading-relaxed text-contrast-500">
      Watch the pipeline run, then poke the live instance. Everything here is
      real output — real CLI transcripts, real artifacts, no mockups.
    </p>
  </header>

  <section aria-label="Watch the demo" class="grid gap-4 sm:grid-cols-2">
    <a
      href="/demo"
      class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60"
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">watch</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">
        The 35-second cut →
      </h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        Autoplays the whole pipeline — set up a project, run the gates, ship with
        receipts — from real transcripts.
      </p>
    </a>
    <a
      href="/demo?reel=deep"
      class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60"
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">watch</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">
        The step-through walkthrough →
      </h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        The same run at reading pace — step through each stage and the artifacts
        it leaves behind.
      </p>
    </a>
  </section>

  <section aria-label="The live instance" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-lg border border-contrast-200 bg-background p-6">
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">live · this site</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground">
        This very site is the live instance.
      </h2>
      <p class="mb-4 text-sm leading-relaxed text-contrast-500">
        Blueprint built the site you are reading — same pipeline, same gates. The
        decisions and fact-checks behind it are public.
      </p>
      <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[12px] uppercase tracking-wide">
        <a href="/" class="text-brand hover:underline">The homepage →</a>
        <a href="/inspect" class="text-brand hover:underline">The receipts →</a>
      </div>
    </div>
    <a
      href="https://blueprint.rallyhq.app/"
      target="_blank"
      rel="noopener"
      class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60"
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">live · a real product</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">
        On a product that already shipped ↗
      </h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        Rally HQ is a working tournament platform. Blueprint wrapped it as a
        brownfield consumer — the same gates, applied to code already in
        production. Its portal — research, decisions, prototype — is public.
      </p>
    </a>
    <a
      href="https://nino-chavez-photography-blueprint.pages.dev/"
      target="_blank"
      rel="noopener"
      class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60"
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">live · a real product</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">
        On a live photography gallery ↗
      </h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        Nino Chavez Photography is a live action-sports gallery (~20K photos).
        Blueprint applied as a midstream consumer — diagnosing and revising
        in-flight north-star work (the find-my-photos model + the #10 ingest
        rebuild) against code already in production. Its portal — research,
        decisions, prototype — is public.
      </p>
    </a>
    <a
      href="/learn/getting-started"
      class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60"
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-wide text-brand-strong">run</p>
      <h2 class="mb-1.5 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">
        Run it yourself →
      </h2>
      <p class="text-sm leading-relaxed text-contrast-500">
        One command scaffolds your own initiative — nothing to install, no server
        to stand up.
      </p>
    </a>
  </section>
</Layout>
