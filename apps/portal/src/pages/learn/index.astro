---
import Layout from '@/layouts/Layout.astro';
import { CommandBlock } from '@/components/CommandBlock';

const GH = 'https://github.com/nino-chavez/blueprint/blob/main';

const ROLES = [
  {
    role: 'Operator',
    here: 'You run an initiative end to end and make the stage-gate calls.',
    action: { label: 'Scaffold a portal', cmd: 'npx @nino-chavez-labs/blueprint-cli init' },
    reads: [
      ['METHODOLOGY.md', 'how the pipeline thinks', `${GH}/METHODOLOGY.md`],
      ['variant-selection.md', 'which pipeline you run', `${GH}/docs/variant-selection.md`],
      ['portal-and-tier-ladder.md', 'how you externalize to stakeholders', `${GH}/docs/portal-and-tier-ladder.md`],
    ],
  },
  {
    role: 'Contributor',
    here: 'You send a fix or feature upstream into the methodology.',
    action: { label: 'Route your change', href: `${GH}/CONTRIBUTING.md`, hint: 'File an RFC or a plain PR — one question decides which.' },
    reads: [
      ['CONTRIBUTING.md', 'the routing question + PR checklist', `${GH}/CONTRIBUTING.md`],
      ['amendment-classification-pattern.md', 'the 4-bucket taxonomy', `${GH}/docs/patterns/amendment-classification-pattern.md`],
      ['methodology-amendments-convention.md', 'how to write a promotable amendment', `${GH}/template/docs/methodology/methodology-amendments-convention.md`],
    ],
  },
  {
    role: 'Reviewer',
    here: 'You write or run stage gates and conformance checks.',
    action: { label: 'Run a reviewer', cmd: 'npx @nino-chavez-labs/blueprint-cli review <name> --target=<dir>' },
    reads: [
      ['reviewers/README.md', 'the roster + spec/executable contract', `${GH}/template/.claude/agents/blueprint/reviewers/README.md`],
      ['METHODOLOGY.md', 'the stages your gates sit in', `${GH}/METHODOLOGY.md`],
      ['voice-template.md', 'a concrete gate spec', `${GH}/docs/context/voice-template.md`],
    ],
  },
  {
    role: 'Stakeholder',
    here: 'You own oversight and approval, and consume the output.',
    action: { label: 'Read the 5-minute pitch', href: `${GH}/START-HERE.md`, hint: 'The leadership-facing "why" and what Blueprint produces.' },
    reads: [
      ['START-HERE.md', 'what Blueprint is + what it outputs', `${GH}/START-HERE.md`],
      ['00-charter.md', 'the charter, requirements, gap scorecard', `${GH}/decisions/00-charter.md`],
      ['productization/README.md', 'what shipped and when', `${GH}/docs/productization/README.md`],
    ],
  },
];
---
<Layout title="Learn" description="Start here. Find your role, take the first action, read the three links — operator, contributor, reviewer, or stakeholder.">
  <header class="mb-10 max-w-3xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-wide text-brand">Learn</p>
    <h1 class="mb-3 font-heading text-4xl font-semibold leading-tight tracking-tight">Start here.</h1>
    <p class="text-lg leading-relaxed text-contrast-500">
      Find your role, take the first action, read the three links. No need to read the rest.
    </p>
  </header>

  <!-- Everyone starts here -->
  <section class="mb-14 grid gap-4 sm:grid-cols-2">
    <a href="/learn/getting-started" class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60">
      <p class="mb-1 font-mono text-[10px] uppercase tracking-wide text-contrast-400">Everyone — step 1</p>
      <h2 class="mb-1 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">Getting Started →</h2>
      <p class="text-sm leading-relaxed text-contrast-500">Install the CLI and scaffold your first portal in five minutes.</p>
    </a>
    <a href="/learn/tutorial" class="group block rounded-lg border border-contrast-200 bg-background p-6 transition-colors hover:border-brand/60">
      <p class="mb-1 font-mono text-[10px] uppercase tracking-wide text-contrast-400">Everyone — step 2</p>
      <h2 class="mb-1 font-heading text-xl font-semibold tracking-tight text-foreground group-hover:text-brand">Run Your First Initiative →</h2>
      <p class="text-sm leading-relaxed text-contrast-500">The full pipeline end to end — every stage, every reviewer gate, deploy, verify.</p>
    </a>
  </section>

  <h2 class="mb-1 font-heading text-2xl font-semibold tracking-tight">Then pick your role</h2>
  <p class="mb-6 text-sm text-contrast-500">The lanes reorder by who you are. These are the four.</p>

  <div class="grid gap-5 lg:grid-cols-2">
    {ROLES.map((r) => (
      <section class="rounded-lg border border-contrast-200 bg-background p-6">
        <h3 class="mb-1 font-heading text-lg font-semibold tracking-tight">{r.role}</h3>
        <p class="mb-4 text-sm leading-relaxed text-contrast-500">{r.here}</p>

        <p class="mb-1.5 font-mono text-[10px] uppercase tracking-wide text-contrast-400">First action — {r.action.label}</p>
        {r.action.cmd ? (
          <div class="mb-4"><CommandBlock command={r.action.cmd} client:visible /></div>
        ) : (
          <p class="mb-4 text-sm text-contrast-500">
            {r.action.hint} <a href={r.action.href} target="_blank" rel="noreferrer" class="font-mono text-[12px] uppercase tracking-wide text-brand hover:underline">open ↗</a>
          </p>
        )}

        <p class="mb-1.5 font-mono text-[10px] uppercase tracking-wide text-contrast-400">Read first</p>
        <ul class="space-y-1.5">
          {r.reads.map(([name, desc, href]) => (
            <li class="text-sm leading-snug">
              <a href={href} target="_blank" rel="noreferrer" class="font-mono text-[13px] text-brand hover:underline">{name}</a>
              <span class="text-contrast-500"> — {desc}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- Optional / advanced — only the operators who need it land here -->
  <section class="mt-12 rounded-lg border border-contrast-200 bg-contrast-50/40 p-6">
    <h2 class="mb-1 font-heading text-lg font-semibold tracking-tight">Going further — running a team</h2>
    <p class="mb-4 max-w-2xl text-sm leading-relaxed text-contrast-500">
      Solo Blueprint needs none of this. The moment a second operator (or a second concurrent agent
      session) joins, coordination is the <strong>Hive</strong> substrate — optional, off by default,
      and worth standing up only when contention is real. Read the litmus before the bootstrap.
    </p>
    <ul class="space-y-1.5">
      <li class="text-sm leading-snug">
        <a href={`${GH}/docs/governance/team-roles-and-conventions.md`} target="_blank" rel="noreferrer" class="font-mono text-[13px] text-brand hover:underline">team-roles-and-conventions.md</a>
        <span class="text-contrast-500"> — the three zero-infra conventions + the crawl→walk→run litmus (read this first)</span>
      </li>
      <li class="text-sm leading-snug">
        <a href={`${GH}/docs/patterns/hive-coordination-pattern.md`} target="_blank" rel="noreferrer" class="font-mono text-[13px] text-brand hover:underline">hive-coordination-pattern.md</a>
        <span class="text-contrast-500"> — what Hive is, when to use it, and <code class="text-[12px]">blueprint hive setup</code> to stand one up</span>
      </li>
      <li class="text-sm leading-snug">
        <a href={`${GH}/docs/governance/hive-identity-gap.md`} target="_blank" rel="noreferrer" class="font-mono text-[13px] text-brand hover:underline">hive-identity-gap.md</a>
        <span class="text-contrast-500"> — the shared-bearer trust limitation; required reading before any client engagement</span>
      </li>
    </ul>
  </section>
</Layout>
