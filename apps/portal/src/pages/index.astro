---
import Layout from '@/layouts/Layout.astro';
import { CommandBlock } from '@/components/CommandBlock';
import { loadAdrCount, loadConsumerCount, loadReviewerCount, loadWaveCount } from '@/lib/derived';

const adrCount = loadAdrCount();
const waveCount = loadWaveCount();
const consumerCount = loadConsumerCount();
const reviewerCount = loadReviewerCount();

const INSTALL = 'npx @nino-chavez-labs/blueprint-cli init --name=my-initiative';
const NPM_URL = 'https://www.npmjs.com/package/@nino-chavez-labs/blueprint-cli';
const REPO_URL = 'https://github.com/nino-chavez/blueprint';

// The seven-stage pipeline (README § How It Works), public framing.
const STAGES = [
  ['Research', 'competitive analysis, codebase, comparables'],
  ['Design', "define scope — what the prototype will and won't do"],
  ['Prototype', 'HTML pages matching the real product'],
  ['Fact-check', 'every claim validated against source'],
  ['Document', 'strategy, feasibility, integration plans'],
  ['Deploy', 'one portal — docs + prototype + chat'],
  ['Iterate', 'stakeholder feedback, triaged'],
] as const;

const COMMANDS = [
  ['init', 'Scaffold a new initiative and its portal — your variant, tier, and pattern choices validated before anything is written.'],
  ['review', 'Run a stage gate: an automated reviewer that checks a stage is actually done. `--list` shows built-in + your own.'],
  ['cost', 'Per-stage effort/model configuration and telemetry — dial spend up or down.'],
  ['fleet', 'One report across every project running Blueprint: which are current, which have fallen behind.'],
  ['upgrade', 'Move a project to the latest methodology version — preview first, dry-run by default.'],
  ['doctor', 'Health check: loads the config, every reviewer, and the portal — and says what it didn’t check.'],
  ['hive', 'Set up the shared workspace a team of agents coordinates through. `hive setup` shows its plan first — nothing is provisioned until you pass `--execute`.'],
] as const;

const DEEPER = [
  ['Learn — run your first initiative', 'Getting started, the full end-to-end tutorial, and role-routed paths.', '/learn'],
  ['Watch the demo', '35-second sizzle or the step-through walkthrough — real transcripts, real artifacts.', '/demo'],
  ['Methodology', 'The first principles, the seven stages, how variant and tier get picked.', '/inspect'],
  ['Decisions', `${adrCount} architecture decision records — the why behind every primitive.`, '/inspect'],
  ['Strategy — the bet itself', 'North star, value prop, and why this exists — the strategy excerpts.', '/discover'],
  ['FAQ — the honest objections', 'The questions a skeptic asks first, answered straight.', '/faq'],
  ['How it compares', "A source-level read of 15 spec-driven tools — what each one's gates actually do.", '/compare'],
  ['Source on GitHub', 'The methodology, the CLI, the template, the reviewer set.', REPO_URL],
] as const;
---
<Layout
  title="Blueprint"
  description="AI-assisted projects move fast — and rot fast. Blueprint adds the checkpoints and the paper trail: an agent runs research, prototype, strategy docs, and fact-check; you ship work that holds up."
>
  <!-- HERO ------------------------------------------------------------------ -->
  <section class="mx-auto max-w-3xl pt-10 pb-20 text-center sm:pt-16">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-contrast-200 bg-contrast-100/50 px-3 py-1 font-mono text-[12px] uppercase tracking-wide text-contrast-500">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand"></span>
      Agent-assisted product initiatives · MIT · on npm
    </p>
    <h1 class="mb-5 font-heading text-5xl font-semibold leading-[1.05] tracking-tight text-foreground sm:text-6xl">
      Run a product initiative,<br />end&nbsp;to&nbsp;end.
    </h1>
    <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-contrast-500">
      AI-assisted projects move fast — and rot fast. Blueprint is a working method
      for running a product initiative with an AI agent — research through
      deployment. The agent does the building; the method supplies the checkpoints
      and the paper trail. What ships is researched, prototyped, fact-checked, and
      documented.
    </p>
    <div class="mx-auto mb-6 max-w-xl text-left">
      <CommandBlock command={INSTALL} client:visible />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[12px] uppercase tracking-wide">
      {/* bg-brand-strong, not bg-brand: white-on-brand measures 4.42:1 — under
          AA for this 12px label (agency audit 2026-06-11, same pair as the
          small-link rule). */}
      <a href="#quickstart" class="rounded-md bg-brand-strong px-4 py-2 text-background no-underline transition-opacity hover:opacity-90">Quickstart ↓</a>
      <a href="/demo" class="text-contrast-500 hover:text-brand">Watch the demo →</a>
      <a href="#in-30-seconds" class="text-contrast-500 hover:text-brand">What is this? ↓</a>
      <a href={NPM_URL} target="_blank" rel="noreferrer" class="text-contrast-500 hover:text-brand">npm ↗</a>
      <a href={REPO_URL} target="_blank" rel="noreferrer" class="text-contrast-500 hover:text-brand">github ↗</a>
    </div>
  </section>

  <!-- THE 30-SECOND VERSION --------------------------------------------------- -->
  <!-- Serves the casual-visitor JTBD (single scroll, no practitioner vocabulary).
       Prescription: docs/content/2026-06-09-front-door-prescription.md (P2).
       This strip answers what/why/who itself — never defer comprehension to an
       agent (P3). Practitioner depth starts at #what, behind this.
       Who-it's-for carries the team-alignment story per F1
       (feedback/2026-06-10-triage.md). -->
  <section id="in-30-seconds" class="border-t border-contrast-100 bg-contrast-100/40 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">plain language</p>
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">The 30-second version.</h2>
      <p class="mx-auto mb-10 max-w-2xl text-contrast-500">Just the strip. Everything below goes deeper.</p>
    </div>
    <div class="mx-auto grid max-w-5xl gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">What it is</h3>
        <p class="text-base leading-relaxed text-contrast-500">
          A method for doing product work with an AI carrying the heavy lifting.
          The AI researches, prototypes, and drafts the documents; Blueprint is
          the set of checkpoints that keeps the work verifiable.
        </p>
      </div>
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">Why it exists</h3>
        <p class="text-base leading-relaxed text-contrast-500">
          AI-built work is fast and convincing — and that's the problem.
          Confident claims nobody verified, decisions nobody wrote down.
          Blueprint forces the receipts: every claim traced, every decision
          recorded, every stage checked before the next one starts.
        </p>
      </div>
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">Who it's for</h3>
        <p class="text-base leading-relaxed text-contrast-500">
          Anyone shipping product work with an AI agent — solo or in a team.
          Solo, it's quality control: fast doesn't mean sloppy. In a team,
          it's the harder problem: everyone has their own way of keeping AI
          honest, and none of them line up. Blueprint is one way the whole
          team can share.
        </p>
      </div>
    </div>
    <!-- F1 (feedback/2026-06-10-triage.md): the broader-goal narrative gets a
         front-door surface — the first buyer-persona reader had to ask for it. -->
    <p class="mx-auto mt-8 text-center font-mono text-[12px] tracking-wide text-contrast-500">
      <span class="uppercase">the thinking behind it</span> —
      <a href="https://ninochavez.co/blog/the-kitchen-i-am-looking-for" target="_blank" rel="noreferrer" class="text-brand-strong hover:opacity-80">The kitchen I'm looking for ↗</a>
    </p>
  </section>

  <!-- PIPELINE --------------------------------------------------------------- -->
  <section id="what" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">how it works</p>
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">One pipeline. Seven stages.</h2>
      <p class="mx-auto mb-10 max-w-2xl text-contrast-500">
        Each stage produces artifacts that feed the next. The insight:
        <strong class="font-medium text-foreground">prototype and documents are built simultaneously</strong> —
        the prototype tests the decision, the docs capture the rationale.
      </p>
    </div>
    <!-- Flow spine, desktop only: the cards enumerate the stages but never
         draw the flow or the gates — the page's thesis (agency audit
         2026-06-11). Nodes are the stage numbers; the diamond between each
         pair is the reviewer gate. The row is aria-hidden because the
         ordered list below carries the same stages for assistive tech;
         on mobile the grid stays the only rendering. -->
    <div class="mx-auto mb-8 hidden max-w-5xl sm:block">
      <div class="flex items-center" aria-hidden="true">
        {STAGES.map((_, i) => (
          <Fragment>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-contrast-200 bg-background font-mono text-[12px] font-medium text-brand-strong">{String(i + 1).padStart(2, '0')}</span>
            {i < STAGES.length - 1 && (
              <span class="flex min-w-0 flex-1 items-center">
                <span class="h-px flex-1 bg-contrast-200"></span>
                <span class="h-1.5 w-1.5 shrink-0 rotate-45 bg-brand"></span>
                <span class="h-px flex-1 bg-contrast-200"></span>
              </span>
            )}
          </Fragment>
        ))}
      </div>
      <p class="mt-3 text-center text-sm text-contrast-500">A gate sits between every stage — work doesn’t advance until it passes. Some gates run an automated reviewer; the rest check the artifacts on disk.</p>
    </div>
    <!-- A real grid, left-aligned: the 7th card lands in column 1 of its row.
         Audit evidence: a centered flex-wrap bottom row floats OFF the column
         grid and reads as misalignment — column snap IS the polish signal. -->
    <ol class="mx-auto grid max-w-5xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {STAGES.map(([name, desc], i) => (
        <li class="rounded-lg border border-contrast-200 bg-background p-4">
          <div class="mb-1.5 flex items-center gap-2">
            <span class="font-mono text-[12px] font-medium text-brand-strong">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-heading text-base font-semibold tracking-tight">{name}</span>
          </div>
          <p class="text-sm leading-relaxed text-contrast-500">{desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- PROOF ------------------------------------------------------------------ -->
  <section id="demo" class="border-t border-contrast-100 bg-contrast-100/40 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">proof</p>
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">This site is Blueprint output.</h2>
      <p class="mx-auto mb-8 max-w-2xl text-contrast-500">
        Every page here was generated from a single <code class="font-mono text-[14px]">blueprint.yml</code>
        by the same pipeline you’d run. The CLI is live on npm; the portal deploys from one config.
        Blueprint runs on itself — the methodology, applied to productizing the methodology.
      </p>
      <!-- Receipts, not adjectives: every count derives at build time from the
           artifact it claims (src/lib/derived.ts loaders; commands from
           COMMANDS.length) so a stale literal can't ship — the wave-59
           stateful-claim rule applied to the front door. -->
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-x-8 gap-y-3 rounded-lg border border-contrast-200 bg-contrast-100/40 px-6 py-5">
        <div><span class="font-heading text-2xl font-semibold text-foreground">{waveCount}</span><span class="ml-1.5 text-sm text-contrast-500">gated updates</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">{adrCount}</span><span class="ml-1.5 text-sm text-contrast-500">decision records</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">{reviewerCount}</span><span class="ml-1.5 text-sm text-contrast-500">automated reviewers</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">{consumerCount}</span><span class="ml-1.5 text-sm text-contrast-500">projects running Blueprint</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">{COMMANDS.length}</span><span class="ml-1.5 text-sm text-contrast-500">CLI commands</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">1</span><span class="ml-1.5 text-sm text-contrast-500">config → whole portal</span></div>
        <a href="/learn" class="font-mono text-[12px] uppercase tracking-wide text-brand-strong hover:underline">Run your first initiative →</a>
      </div>
    </div>
  </section>

  <!-- QUICKSTART ------------------------------------------------------------- -->
  <section id="quickstart" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl">
      <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">get started</p>
      <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">Up and running in five steps.</h2>
      <p class="mb-10 text-contrast-500">Five steps. The choices you make are written out below — every command runs as printed.</p>

      <!-- min-w-0 on every step-content div: a grid child defaults to
           min-width:auto and refuses to shrink below CommandBlock's nowrap
           command line, which silently disables its overflow-x-auto and drags
           the page 629px wide at 390px (WCAG 1.4.10 — agency audit 2026-06-11). -->
      <ol class="space-y-8">
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">1</span>
          <div class="min-w-0">
            <h3 class="mb-1 font-heading text-lg font-semibold tracking-tight">Prerequisites</h3>
            <p class="text-[15px] leading-relaxed text-contrast-500">Node 18+ and <a href="https://claude.com/claude-code" target="_blank" rel="noreferrer" class="text-brand-strong hover:underline">Claude Code</a>. That’s it — there’s no server to stand up and nothing to host.</p>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">2</span>
          <div class="min-w-0">
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Scaffold your initiative</h3>
            <p class="mb-3 text-[15px] leading-relaxed text-contrast-500">Generates a portal you own, validated against your config. <code class="font-mono text-[13px] text-foreground">--name</code> is the only required flag — everything else defaults and is echoed back. Two starting points:</p>
            <!-- Both commands verified to run as printed (wave 61: the stamper
                 derives defaults for every flag but --name and creates the
                 target dir — the 2026-06-10 audit's unrunnable-command fix,
                 solved in the product instead of with longer copy). -->
            <div class="space-y-3">
              <div>
                <p class="mb-1.5 text-[13px] leading-relaxed text-contrast-500"><span class="font-medium text-foreground">New idea</span> — nothing exists yet. That’s all <code class="font-mono text-[12px] text-foreground">greenfield</code> (the default) means.</p>
                <CommandBlock command="npx @nino-chavez-labs/blueprint-cli init --name=my-initiative" client:visible />
              </div>
              <div>
                <p class="mb-1.5 text-[13px] leading-relaxed text-contrast-500"><span class="font-medium text-foreground">Existing app</span> — run it from that repo. That’s <code class="font-mono text-[12px] text-foreground">brownfield</code>.</p>
                <CommandBlock command="npx @nino-chavez-labs/blueprint-cli init --name=my-app --variant=brownfield --target=." client:visible />
              </div>
            </div>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">3</span>
          <div class="min-w-0">
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Configure</h3>
            <p class="mb-3 text-[15px] leading-relaxed text-contrast-500">Set the three things that matter in <code class="font-mono text-[13px]">blueprint.yml</code> — the rest has sane defaults.</p>
            <pre class="overflow-x-auto rounded-lg border border-contrast-200 bg-contrast-100/60 px-4 py-3 font-mono text-[13px] leading-relaxed text-foreground"><code>variant: brownfield   <span class="text-contrast-500"># greenfield | midstream | brownfield</span>
tier: 1               <span class="text-contrast-500"># deliverable sophistication 0–2</span>
portal_type: initiative  <span class="text-contrast-500"># initiative = product front-door · review = redesign review</span></code></pre>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">4</span>
          <div class="min-w-0">
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Run the pipeline</h3>
            <p class="mb-3 text-[15px] leading-relaxed text-contrast-500">In Claude Code, the stages are skills. Run them in order — each stage has a gate it has to clear first.</p>
            <CommandBlock command="/blueprint-research → /blueprint-prototype → /blueprint-validate → /blueprint-docs → /blueprint-deploy" prompt="" client:visible />
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">5</span>
          <div class="min-w-0">
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Ship &amp; check</h3>
            <p class="mb-3 text-[15px] leading-relaxed text-contrast-500">Push and your portal deploys. Verify conformance — <code class="font-mono text-[13px] text-foreground">doctor</code> is honest about what it didn’t check.</p>
            <CommandBlock command="npx @nino-chavez-labs/blueprint-cli doctor" client:visible />
          </div>
        </li>
      </ol>
      <p class="mt-8 text-[15px] leading-relaxed text-contrast-500">
        Want the whole thing — stage by stage, every reviewer gate, on a real initiative? →
        <a href="/learn/tutorial" class="font-medium text-brand-strong hover:underline">Run your first initiative</a>,
        or start at <a href="/learn" class="font-medium text-brand-strong hover:underline">Learn</a>.
      </p>
    </div>
  </section>

  <!-- COMMANDS --------------------------------------------------------------- -->
  <section id="commands" class="border-t border-contrast-100 py-12">
    <div class="mx-auto max-w-5xl">
      <!-- Header lives in the 3xl column even though the grid is 5xl — section
           headings keep ONE left edge downpage (audit: 128px jumps between
           3xl and 5xl sections read as a ragged margin). -->
      <div class="mx-auto max-w-3xl">
        <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">reference</p>
        <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">The CLI</h2>
        <p class="mb-10 text-contrast-500">{COMMANDS.length} commands, all real. <code class="font-mono text-[13px]">npx @nino-chavez-labs/blueprint-cli &lt;command&gt;</code> — zero install.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {COMMANDS.map(([name, desc]) => (
          <div class="rounded-lg border border-contrast-200 bg-background p-5">
            <h3 class="mb-1.5 font-mono text-sm font-semibold text-brand-strong">blueprint {name}</h3>
            <p class="text-[15px] leading-relaxed text-contrast-500" set:html={desc.replace(/`([^`]+)`/g, '<code class="font-mono text-[13px] text-foreground">$1</code>')} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTRIBUTE ------------------------------------------------------------- -->
  <section id="contribute" class="border-t border-contrast-100 py-12">
    <div class="mx-auto max-w-3xl">
      <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">ecosystem</p>
      <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">Stay current. Feed back upstream.</h2>
      <p class="mb-10 text-contrast-500">Updates flow down without breaking you; your fixes and gaps flow back up.</p>
      {/* min-w-0 on both grid children: same min-width:auto trap as the
          quickstart steps — the nowrap CommandBlock otherwise widens the card
          past the mobile viewport (residual 152px overflow, live-measured). */}
      <div class="grid gap-6 md:grid-cols-2">
        <div class="min-w-0 rounded-lg border border-contrast-200 bg-background p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Pull updates</h3>
          <p class="mb-4 text-[15px] leading-relaxed text-contrast-500"><code class="font-mono text-[13px] text-foreground">blueprint upgrade</code> reads the methodology version your project is pinned to, shows what changed, and updates it — non-breaking, dry-run by default. <code class="font-mono text-[13px] text-foreground">blueprint fleet</code> shows which of your initiatives have fallen behind.</p>
          <CommandBlock command="npx @nino-chavez-labs/blueprint-cli upgrade" client:visible />
        </div>
        <div class="min-w-0 rounded-lg border border-contrast-200 bg-background p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Report &amp; request upstream</h3>
          <p class="mb-4 text-[15px] leading-relaxed text-contrast-500">Hit a gap, a bug, or a feature need? File an amendment or RFC. Triage routes it automatically — substantial change → RFC first, bug-fix → straight PR.</p>
          <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer" class="inline-block rounded-md border border-contrast-200 px-4 py-2 font-mono text-[12px] uppercase tracking-wide text-contrast-500 transition-colors hover:border-brand/60 hover:text-brand">How to contribute →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEEPER ----------------------------------------------------------------- -->
  <section id="docs" class="border-t border-contrast-100 py-12">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl">
        <p class="mb-2 font-mono text-[12px] uppercase tracking-wide text-brand-strong">further reading</p>
        <h2 class="mb-10 font-heading text-3xl font-semibold tracking-tight">Go deeper</h2>
      </div>
      <!-- 5 cards in 2 cols = an empty cell; the Learn card spans the first
           row as the featured entry instead (audit finding #5). -->
      <div class="grid gap-4 sm:grid-cols-2">
        {DEEPER.map(([title, desc, href], i) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined} class:list={['group block rounded-lg border border-contrast-200 bg-background p-5 transition-colors hover:border-brand/60', i === 0 && 'sm:col-span-2']}>
            <h3 class="mb-1 font-heading text-base font-semibold tracking-tight text-foreground group-hover:text-brand">{title}</h3>
            <p class="text-sm leading-relaxed text-contrast-500">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
