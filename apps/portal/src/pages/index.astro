---
import Layout from '@/layouts/Layout.astro';
import { CommandBlock } from '@/components/CommandBlock';
import { loadAdrCount } from '@/lib/derived';

const adrCount = loadAdrCount();

const INSTALL = 'npx @nino-chavez-labs/blueprint-cli init';
const NPM_URL = 'https://www.npmjs.com/package/@nino-chavez-labs/blueprint-cli';
const REPO_URL = 'https://github.com/nino-chavez/blueprint';

// The seven-stage pipeline (README § How It Works), public framing.
const STAGES = [
  ['Research', 'competitive analysis, codebase, comparables'],
  ['Design', 'codify what the prototype can and cannot do'],
  ['Prototype', 'HTML pages matching the real product'],
  ['Fact-check', 'every claim validated against source'],
  ['Document', 'strategy, feasibility, integration plans'],
  ['Deploy', 'one portal — docs + prototype + chat'],
  ['Iterate', 'stakeholder feedback, triaged'],
] as const;

const COMMANDS = [
  ['init', 'Scaffold a new initiative and its portal — validated against the variant × tier matrix.'],
  ['review', 'Run an executable stage-gate reviewer. `--list` shows canonical + org-authored ones.'],
  ['cost', 'Per-stage effort/model configuration and telemetry — dial spend up or down.'],
  ['fleet', 'Classify every consumer’s drift from the methodology, from one registry.'],
  ['upgrade', 'Bump a consumer’s methodology pin — terraform-style, dry-run by default.'],
  ['doctor', 'Conformance + health: loads the config, every reviewer, and portal checks.'],
] as const;

const DEEPER = [
  ['Learn — run your first initiative', 'Getting started, the full end-to-end tutorial, and role-routed paths.', '/learn'],
  ['Methodology', 'The first principles, the seven stages, the variant ladder.', '/inspect'],
  ['Decisions', `${adrCount} architecture decision records — the why behind every primitive.`, '/inspect'],
  ['The live portal', 'Discover · Try · Build · Operate · Inspect · Roadmap — the deeper reference.', '/discover'],
  ['Source on GitHub', 'The methodology, the CLI, the template, the reviewer set.', REPO_URL],
] as const;
---
<Layout
  title="Blueprint"
  description="AI-assisted projects move fast — and rot fast. Blueprint adds the checkpoints and the paper trail: an agent runs research, prototype, strategy docs, and fact-check; you ship work that holds up."
>
  <!-- HERO ------------------------------------------------------------------ -->
  <section class="mx-auto max-w-3xl pt-6 pb-16 text-center sm:pt-10">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-contrast-200 bg-contrast-100/50 px-3 py-1 font-mono text-[11px] uppercase tracking-wide text-contrast-500">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand"></span>
      Agent-assisted product initiatives · MIT · on npm
    </p>
    <h1 class="mb-5 font-heading text-5xl font-semibold leading-[1.05] tracking-tight text-foreground sm:text-6xl">
      Run a product initiative,<br />end&nbsp;to&nbsp;end.
    </h1>
    <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-contrast-500">
      AI-assisted projects move fast — and rot fast. Blueprint is a working method
      for product work with an AI agent: the agent does the building, the method
      supplies the checkpoints and the paper trail, and what ships is researched,
      prototyped, fact-checked, and explained.
    </p>
    <div class="mx-auto mb-6 max-w-xl text-left">
      <CommandBlock command={INSTALL} client:visible />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[12px] uppercase tracking-wide">
      <a href="#quickstart" class="rounded-md bg-brand px-4 py-2 text-background no-underline transition-opacity hover:opacity-90">Quickstart ↓</a>
      <a href={NPM_URL} target="_blank" rel="noreferrer" class="text-contrast-500 hover:text-brand">npm ↗</a>
      <a href={REPO_URL} target="_blank" rel="noreferrer" class="text-contrast-500 hover:text-brand">github ↗</a>
    </div>
  </section>

  <!-- THE 30-SECOND VERSION --------------------------------------------------- -->
  <!-- Serves the casual-visitor JTBD (single scroll, no practitioner vocabulary).
       Prescription: docs/content/2026-06-09-front-door-prescription.md (P2).
       This strip answers what/why/who itself — never defer comprehension to an
       agent (P3). Practitioner depth starts at #what, behind this. -->
  <section id="in-30-seconds" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">The 30-second version.</h2>
      <p class="mx-auto mb-10 max-w-2xl text-contrast-500">Plain language. Everything below this strip goes deeper; nothing in it is required to understand the idea.</p>
    </div>
    <div class="mx-auto grid max-w-5xl gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">What it is</h3>
        <p class="text-sm leading-relaxed text-contrast-500">
          A method for doing product work with an AI carrying the heavy lifting.
          The AI researches, prototypes, and drafts the documents; Blueprint is
          the set of checkpoints that makes it show its work.
        </p>
      </div>
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">Why it exists</h3>
        <p class="text-sm leading-relaxed text-contrast-500">
          AI-built work is fast and convincing — and that's the problem.
          Confident claims nobody verified, decisions nobody wrote down.
          Blueprint forces the receipts: every claim traced, every decision
          recorded, every stage checked before the next one starts.
        </p>
      </div>
      <div class="rounded-lg border border-contrast-200 bg-background p-5 text-left">
        <h3 class="mb-2 font-heading text-base font-semibold tracking-tight">Who it's for</h3>
        <p class="text-sm leading-relaxed text-contrast-500">
          People shipping product work with an AI in the loop — solo builders
          through client teams. If that's not you, the one-line takeaway:
          it's quality control for AI-built work.
        </p>
      </div>
    </div>
  </section>

  <!-- PIPELINE --------------------------------------------------------------- -->
  <section id="what" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">One pipeline. Seven stages.</h2>
      <p class="mx-auto mb-10 max-w-2xl text-contrast-500">
        Each stage produces artifacts that feed the next. The insight:
        <strong class="font-medium text-foreground">prototype and documents are built simultaneously</strong> —
        the prototype tests the decision, the docs capture the rationale.
      </p>
    </div>
    <ol class="mx-auto grid max-w-5xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {STAGES.map(([name, desc], i) => (
        <li class="rounded-lg border border-contrast-200 bg-background p-4">
          <div class="mb-1.5 flex items-center gap-2">
            <span class="font-mono text-[11px] font-medium text-contrast-400">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-heading text-base font-semibold tracking-tight">{name}</span>
          </div>
          <p class="text-sm leading-relaxed text-contrast-500">{desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- PROOF ------------------------------------------------------------------ -->
  <section id="demo" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-3 font-heading text-3xl font-semibold tracking-tight">This site is Blueprint output.</h2>
      <p class="mx-auto mb-8 max-w-2xl text-contrast-500">
        Every page here was generated from a single <code class="font-mono text-[14px]">blueprint.yml</code>
        by the same pipeline you’d run. The CLI is live on npm; the portal deploys from one config.
        Blueprint is its own first consumer — the methodology used to productize the methodology.
      </p>
      <div class="mx-auto flex max-w-xl flex-wrap items-center justify-center gap-x-8 gap-y-3 rounded-lg border border-contrast-200 bg-contrast-100/40 px-6 py-5">
        <div><span class="font-heading text-2xl font-semibold text-foreground">{adrCount}</span><span class="ml-1.5 text-sm text-contrast-500">ADRs</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">6</span><span class="ml-1.5 text-sm text-contrast-500">CLI commands</span></div>
        <div><span class="font-heading text-2xl font-semibold text-foreground">1</span><span class="ml-1.5 text-sm text-contrast-500">config → whole portal</span></div>
        <a href="/discover" class="font-mono text-[12px] uppercase tracking-wide text-brand hover:underline">explore it →</a>
      </div>
    </div>
  </section>

  <!-- QUICKSTART ------------------------------------------------------------- -->
  <section id="quickstart" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">Up and running in five steps.</h2>
      <p class="mb-10 text-contrast-500">Copy, paste, go. No decisions to make first.</p>

      <ol class="space-y-8">
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">1</span>
          <div>
            <h3 class="mb-1 font-heading text-lg font-semibold tracking-tight">Prerequisites</h3>
            <p class="text-sm leading-relaxed text-contrast-500">Node 18+ and <a href="https://claude.com/claude-code" target="_blank" rel="noreferrer" class="text-brand hover:underline">Claude Code</a>. That’s it — there’s no server to stand up and nothing to host.</p>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">2</span>
          <div>
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Scaffold your initiative</h3>
            <p class="mb-3 text-sm leading-relaxed text-contrast-500">Stamps a portal you own, validated against the variant × tier matrix.</p>
            <CommandBlock command="npx @nino-chavez-labs/blueprint-cli init --pattern=A --target=my-initiative" client:visible />
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">3</span>
          <div>
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Configure</h3>
            <p class="mb-3 text-sm leading-relaxed text-contrast-500">Set the three things that matter in <code class="font-mono text-[13px]">blueprint.yml</code> — the rest has sane defaults.</p>
            <pre class="overflow-x-auto rounded-lg border border-contrast-200 bg-contrast-100/60 px-4 py-3 font-mono text-[13px] leading-relaxed text-foreground"><code>variant: brownfield   <span class="text-contrast-400"># greenfield | midstream | brownfield</span>
tier: 1               <span class="text-contrast-400"># deliverable sophistication 0–2</span>
portal_pattern: A     <span class="text-contrast-400"># A = platform portal · B = redesign review</span></code></pre>
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">4</span>
          <div>
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Run the pipeline</h3>
            <p class="mb-3 text-sm leading-relaxed text-contrast-500">In Claude Code, the stages are skills. Run them in order — each gate is enforced by a reviewer.</p>
            <CommandBlock command="/blueprint-research → /blueprint-prototype → /blueprint-docs → /blueprint-validate → /blueprint-deploy" prompt="" client:visible />
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] gap-4">
          <span class="font-heading text-lg font-semibold text-brand">5</span>
          <div>
            <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Ship &amp; check</h3>
            <p class="mb-3 text-sm leading-relaxed text-contrast-500">Push and your portal deploys. Verify conformance — doctor is honest about what it didn’t check.</p>
            <CommandBlock command="npx @nino-chavez-labs/blueprint-cli doctor" client:visible />
          </div>
        </li>
      </ol>
      <p class="mt-8 text-sm leading-relaxed text-contrast-500">
        Want the whole thing — stage by stage, every reviewer gate, on a real initiative? →
        <a href="/learn/tutorial" class="font-medium text-brand hover:underline">Run your first initiative</a>,
        or start at <a href="/learn" class="font-medium text-brand hover:underline">Learn</a>.
      </p>
    </div>
  </section>

  <!-- COMMANDS --------------------------------------------------------------- -->
  <section id="commands" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">The CLI</h2>
      <p class="mb-10 text-contrast-500">Six commands, all real. <code class="font-mono text-[13px]">npx @nino-chavez-labs/blueprint-cli &lt;command&gt;</code> — zero install.</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {COMMANDS.map(([name, desc]) => (
          <div class="rounded-lg border border-contrast-200 bg-background p-5">
            <h3 class="mb-1.5 font-mono text-sm font-semibold text-brand">blueprint {name}</h3>
            <p class="text-sm leading-relaxed text-contrast-500" set:html={desc.replace(/`([^`]+)`/g, '<code class="font-mono text-[13px] text-foreground">$1</code>')} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTRIBUTE ------------------------------------------------------------- -->
  <section id="contribute" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-2 font-heading text-3xl font-semibold tracking-tight">Stay current. Feed back upstream.</h2>
      <p class="mb-10 text-contrast-500">Updates flow down without breaking you; your fixes and gaps flow back up.</p>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-contrast-200 bg-background p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Pull updates</h3>
          <p class="mb-4 text-sm leading-relaxed text-contrast-500"><code class="font-mono text-[13px] text-foreground">blueprint upgrade</code> reads your methodology pin, shows the delta, and bumps it — non-breaking, dry-run by default. <code class="font-mono text-[13px] text-foreground">blueprint fleet</code> shows drift across every initiative.</p>
          <CommandBlock command="npx @nino-chavez-labs/blueprint-cli upgrade" client:visible />
        </div>
        <div class="rounded-lg border border-contrast-200 bg-background p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold tracking-tight">Report &amp; request upstream</h3>
          <p class="mb-4 text-sm leading-relaxed text-contrast-500">Hit a gap, a bug, or a feature need? File an amendment or RFC. The 4-bucket triage routes it automatically — substantial change → RFC first, bug-fix → straight PR.</p>
          <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer" class="inline-block rounded-md border border-contrast-200 px-4 py-2 font-mono text-[12px] uppercase tracking-wide text-contrast-500 transition-colors hover:border-brand/60 hover:text-brand">How to contribute →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEEPER ----------------------------------------------------------------- -->
  <section id="docs" class="border-t border-contrast-100 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-10 font-heading text-3xl font-semibold tracking-tight">Go deeper</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {DEEPER.map(([title, desc, href]) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined} class="group block rounded-lg border border-contrast-200 bg-background p-5 transition-colors hover:border-brand/60">
            <h3 class="mb-1 font-heading text-base font-semibold tracking-tight text-foreground group-hover:text-brand">{title}</h3>
            <p class="text-sm leading-relaxed text-contrast-500">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
